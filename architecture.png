<svg xmlns="http://www.w3.org/2000/svg" width="1500" height="1120" viewBox="0 0 1500 1120" role="img" aria-labelledby="title desc">
  <title id="title">ShopLedger application architecture and order flow</title>
  <desc id="desc">Architecture map of the browser UI, Express server, all route and library modules, configuration, JSON data file, and the numbered flow for placing an order.</desc>
  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L10,5 L0,10 z" fill="#64748b"/>
    </marker>
    <marker id="arrowBlue" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L10,5 L0,10 z" fill="#2563eb"/>
    </marker>
    <style>
      text { font-family: Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; fill: #0f172a; }
      .title { font-size: 30px; font-weight: 750; letter-spacing: -0.4px; }
      .subtitle { font-size: 14px; fill: #64748b; }
      .section { font-size: 15px; font-weight: 750; fill: #334155; letter-spacing: 1px; }
      .box-title { font-size: 15px; font-weight: 700; }
      .box-sub { font-size: 12px; fill: #475569; }
      .small { font-size: 11px; fill: #64748b; }
      .node { fill: #ffffff; stroke: #cbd5e1; stroke-width: 1.5; rx: 12; }
      .ui { fill: #eff6ff; stroke: #93c5fd; }
      .server { fill: #f1f5f9; stroke: #94a3b8; }
      .router { fill: #f5f3ff; stroke: #c4b5fd; }
      .lib { fill: #ecfdf5; stroke: #86efac; }
      .data { fill: #fff7ed; stroke: #fdba74; }
      .config { fill: #fefce8; stroke: #fde047; }
      .flowbox { fill: #ffffff; stroke: #bfdbfe; stroke-width: 1.5; rx: 12; }
      .flow-num { fill: #2563eb; }
      .flow-num-text { fill: #ffffff; font-size: 14px; font-weight: 800; text-anchor: middle; }
      .flow-text { font-size: 13px; font-weight: 650; }
      .flow-sub { font-size: 11px; fill: #475569; }
      .arrow { fill: none; stroke: #64748b; stroke-width: 1.7; marker-end: url(#arrow); }
      .arrow-blue { fill: none; stroke: #2563eb; stroke-width: 2.2; marker-end: url(#arrowBlue); }
      .dashed { stroke-dasharray: 5 5; }
    </style>
  </defs>

  <rect width="1500" height="1120" fill="#f8fafc"/>
  <text x="48" y="54" class="title">ShopLedger · application architecture</text>
  <text x="48" y="80" class="subtitle">Browser UI, Express routes, library modules, configuration, JSON persistence, and order placement</text>

  <!-- Architecture -->
  <text x="48" y="121" class="section">APPLICATION MODULES</text>

  <rect x="48" y="145" width="250" height="176" class="node ui"/>
  <text x="68" y="174" class="box-title">Browser UI</text>
  <text x="68" y="198" class="box-sub">public/index.html</text>
  <text x="68" y="218" class="box-sub">public/js/app.js</text>
  <text x="68" y="238" class="box-sub">public/css/style.css</text>
  <text x="68" y="280" class="small">POS · order history · Khata · reports</text>

  <rect x="350" y="145" width="250" height="176" class="node server"/>
  <text x="370" y="174" class="box-title">Express app</text>
  <text x="370" y="198" class="box-sub">server.js</text>
  <text x="370" y="222" class="small">Static UI · JSON body parser</text>
  <text x="370" y="244" class="small">Registers API routers</text>
  <text x="370" y="277" class="small">GET /orders/:id/invoice</text>

  <rect x="660" y="139" width="358" height="216" class="node router"/>
  <text x="680" y="168" class="box-title">Routes</text>
  <rect x="678" y="182" width="320" height="37" class="node router" rx="8"/>
  <text x="691" y="205" class="box-sub">routes/products.js</text>
  <rect x="678" y="226" width="320" height="37" class="node router" rx="8"/>
  <text x="691" y="249" class="box-sub">routes/orders.js</text>
  <rect x="678" y="270" width="320" height="37" class="node router" rx="8"/>
  <text x="691" y="293" class="box-sub">routes/customers.js</text>
  <rect x="678" y="314" width="320" height="30" class="node router" rx="8"/>
  <text x="691" y="334" class="box-sub">routes/reports.js</text>

  <rect x="1070" y="145" width="190" height="92" class="node config"/>
  <text x="1090" y="174" class="box-title">config.js</text>
  <text x="1090" y="198" class="box-sub">Shop · tax · coupons</text>
  <text x="1090" y="217" class="box-sub">Inventory defaults</text>

  <rect x="1285" y="145" width="170" height="92" class="node data"/>
  <text x="1305" y="174" class="box-title">data/db.json</text>
  <text x="1305" y="198" class="box-sub">Products · orders</text>
  <text x="1305" y="217" class="box-sub">Customers · audit log</text>

  <rect x="660" y="390" width="795" height="181" class="node lib"/>
  <text x="680" y="419" class="box-title">Library modules (lib/)</text>
  <rect x="678" y="433" width="180" height="54" class="node lib" rx="8"/>
  <text x="691" y="456" class="box-sub">lib/store.js</text>
  <text x="691" y="475" class="small">JSON read/write · audit</text>
  <rect x="871" y="433" width="180" height="54" class="node lib" rx="8"/>
  <text x="884" y="456" class="box-sub">lib/orders.js</text>
  <text x="884" y="475" class="small">Order lifecycle · listing</text>
  <rect x="1064" y="433" width="180" height="54" class="node lib" rx="8"/>
  <text x="1077" y="456" class="box-sub">lib/inventory.js</text>
  <text x="1077" y="475" class="small">Stock checks · adjustments</text>
  <rect x="1257" y="433" width="180" height="54" class="node lib" rx="8"/>
  <text x="1270" y="456" class="box-sub">lib/pricing.js</text>
  <text x="1270" y="475" class="small">Subtotal · GST totals</text>

  <rect x="678" y="501" width="180" height="54" class="node lib" rx="8"/>
  <text x="691" y="524" class="box-sub">lib/coupons.js</text>
  <text x="691" y="543" class="small">Validation · discount</text>
  <rect x="871" y="501" width="180" height="54" class="node lib" rx="8"/>
  <text x="884" y="524" class="box-sub">lib/tax.js</text>
  <text x="884" y="543" class="small">HSN rates · CGST/SGST</text>
  <rect x="1064" y="501" width="180" height="54" class="node lib" rx="8"/>
  <text x="1077" y="524" class="box-sub">lib/ledger.js</text>
  <text x="1077" y="543" class="small">Khata · settlements</text>
  <rect x="1257" y="501" width="180" height="54" class="node lib" rx="8"/>
  <text x="1270" y="524" class="box-sub">lib/reports.js</text>
  <text x="1270" y="543" class="small">Dashboard · reconciliation</text>

  <rect x="48" y="365" width="250" height="66" class="node lib"/>
  <text x="68" y="392" class="box-sub">lib/invoice.js</text>
  <text x="68" y="414" class="small">Invoice figures · HTML renderer</text>
  <rect x="350" y="365" width="250" height="66" class="node lib"/>
  <text x="370" y="392" class="box-sub">lib/dates.js</text>
  <text x="370" y="414" class="small">Today · date normalization</text>

  <!-- Architecture connections -->
  <path d="M298 230 H350" class="arrow-blue"/>
  <text x="304" y="218" class="small">HTTP</text>
  <path d="M600 230 H660" class="arrow"/>
  <text x="605" y="218" class="small">/api</text>
  <path d="M475 321 V348 H173 V365" class="arrow"/>
  <path d="M1018 247 H1042 V274 H1070" class="arrow"/>
  <text x="1022" y="238" class="small">uses</text>
  <path d="M1018 282 H1260 V190 H1285" class="arrow"/>
  <text x="1111" y="299" class="small">store.read() / store.write()</text>
  <path d="M600 398 H630 V453 H660" class="arrow"/>
  <path d="M475 321 V345 H1360 V433" class="arrow"/>
  <text x="1198" y="365" class="small">invoice route</text>
  <path d="M1260 190 H1268 V461 H1257" class="arrow dashed"/>
  <path d="M1260 190 H1270 V528 H1244" class="arrow dashed"/>

  <!-- Order workflow -->
  <rect x="38" y="620" width="1424" height="450" fill="#eff6ff" stroke="#bfdbfe" stroke-width="1.5" rx="18"/>
  <text x="64" y="659" class="section" fill="#1d4ed8">ORDER PLACEMENT · POST /api/orders</text>
  <text x="64" y="684" class="subtitle">The browser sends the cart; the route recalculates from stored product data and persists the result.</text>

  <rect x="64" y="718" width="410" height="105" class="flowbox"/>
  <circle cx="91" cy="745" r="15" class="flow-num"/><text x="91" y="750" class="flow-num-text">1</text>
  <text x="117" y="750" class="flow-text">Browser UI submits cart</text>
  <text x="84" y="780" class="flow-sub">items · coupon · customer · paymentMode · status</text>
  <text x="84" y="801" class="flow-sub">POST /api/orders</text>

  <rect x="545" y="718" width="410" height="105" class="flowbox"/>
  <circle cx="572" cy="745" r="15" class="flow-num"/><text x="572" y="750" class="flow-num-text">2</text>
  <text x="598" y="750" class="flow-text">routes/orders.js resolves items</text>
  <text x="565" y="780" class="flow-sub">Looks up products; checks stock and coupon</text>
  <text x="565" y="801" class="flow-sub">pricing.js → coupons.js + tax.js</text>

  <rect x="1026" y="718" width="410" height="105" class="flowbox"/>
  <circle cx="1053" cy="745" r="15" class="flow-num"/><text x="1053" y="750" class="flow-num-text">3</text>
  <text x="1079" y="750" class="flow-text">Khata charge (if paymentMode = khata)</text>
  <text x="1046" y="780" class="flow-sub">ledger.js checks customer and credit limit</text>
  <text x="1046" y="801" class="flow-sub">Then inventory.js adjusts product stock</text>

  <path d="M474 770 H545" class="arrow-blue"/>
  <path d="M955 770 H1026" class="arrow-blue"/>

  <rect x="1026" y="874" width="410" height="105" class="flowbox"/>
  <circle cx="1053" cy="901" r="15" class="flow-num"/><text x="1053" y="906" class="flow-num-text">4</text>
  <text x="1079" y="906" class="flow-text">Order and audit entry are recorded</text>
  <text x="1046" y="936" class="flow-sub">orders.js adds order; store.js writes JSON</text>
  <text x="1046" y="957" class="flow-sub">data/db.json</text>

  <rect x="545" y="874" width="410" height="105" class="flowbox"/>
  <circle cx="572" cy="901" r="15" class="flow-num"/><text x="572" y="906" class="flow-num-text">5</text>
  <text x="598" y="906" class="flow-text">API returns created order</text>
  <text x="565" y="936" class="flow-sub">Browser clears cart and refreshes products</text>
  <text x="565" y="957" class="flow-sub">and dashboard</text>

  <rect x="64" y="874" width="410" height="105" class="flowbox"/>
  <circle cx="91" cy="901" r="15" class="flow-num"/><text x="91" y="906" class="flow-num-text">6</text>
  <text x="117" y="906" class="flow-text">Invoice can be opened separately</text>
  <text x="84" y="936" class="flow-sub">GET /orders/:id/invoice</text>
  <text x="84" y="957" class="flow-sub">lib/invoice.js renders printable HTML</text>

  <path d="M1231 823 V849 H1231 V874" class="arrow-blue"/>
  <path d="M1026 926 H955" class="arrow-blue"/>
  <path d="M545 926 H474" class="arrow-blue"/>

  <text x="64" y="1036" class="small">Other route modules: products · customers · reports. Shared library modules are shown above.</text>
</svg>
